NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://eventful:eventful@localhost:5432/eventful?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

QR_HMAC_SECRET=replace-with-a-long-random-string

TICKETMASTER_API_KEY=
TMDB_API_KEY=

# Stripe Dashboard -> Developers -> API keys (use the test-mode secret key, sk_test_...)
STRIPE_SECRET_KEY=
# Stripe CLI `stripe listen --print-secret` locally, or the Dashboard webhook endpoint's
# signing secret in production (whsec_...)
STRIPE_WEBHOOK_SECRET=
# The recurring monthly Price id for the subscription plan (price_...)
STRIPE_PRICE_ID=
